#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_fr.h"
#include "layers.h"
#include "helpers.h"
#include "combos.h"

&caps_word {
    continue-list = <FR_M UNDERSCORE FR_MINUS BACKSPACE DELETE LSHIFT>;
};

&sk {
    release-after-ms = <10000>;
};

CUSTOM_KEY(zeros, FR_N0, FR_DEGREE)
CUSTOM_KEY(twos, FR_N2, FR_SQUARE)
CUSTOM_KEY(caret_trema, FR_CARET, FR_TREMA)
CUSTOM_KEY(amps_euro, FR_AMPS, FR_EURO)
CUSTOM_KEY(dollar_pound, FR_DOLLAR, FR_POUND_SIGN)
CUSTOM_KEY(hash_micro, FR_HASH, FR_MICRO)
CUSTOM_KEY(space_under, SPACE, FR_UNDER)

// BASE: Right hand custom keys with autoshift
CUSTOM_AUTOSHIFT(commas, FR_COMMA, FR_SEMI)
#define as_commas auto_shift_commas FR_SEMI 0

CUSTOM_AUTOSHIFT(dots, FR_DOT, FR_COLON)
#define as_dots auto_shift_dots FR_COLON 0

CUSTOM_AUTOSHIFT(quotes, FR_SINGLE_QUOTE, FR_DOUBLE_QUOTES)
#define as_quotes auto_shift_quotes FR_DOUBLE_QUOTES 0

CUSTOM_AUTOSHIFT(slashes, KP_SLASH, FR_BACKSLASH)
#define as_slashes auto_shift_slashes FR_BACKSLASH 0




/ {
    conditional_layers {
    };
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "colemak";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
      &kp FR_Q        &kp FR_W        &kp FR_F        &kp FR_P        &kp FR_B                                                                                   &kp FR_J        &kp FR_L        &kp FR_U        &kp FR_Y        &as_quotes   
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &kp FR_A        &kp FR_R        &kp FR_S        &kp FR_T        &kp FR_G                                                                                   &kp FR_M        &kp FR_N        &kp FR_E        &kp FR_I        &kp FR_O
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &kp FR_Z        &kp FR_X        &kp FR_C        &kp FR_D        &kp FR_V        &kp SPACE       &kp ESC                    &kp BSPC        &kp DEL         &kp FR_K        &kp FR_H        &as_commas      &as_dots        &as_slashes
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                      &kp LC(F4)      &mo L_ACT       &mo L_SYM                  &mo L_NUM       &kp LSHIFT      &kp C_MUTE
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LA(LEFT) LA(RIGHT) &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        action_layer {
            display-name = "action";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
    &kp LG(FR_AMPS) &kp LG(FR_E_E)  &kp LG(FR_DQT)  &kp LG(FR_SQT)  &kp LG(FR_LPAR)                                                                              &kp PAGE_UP     &kp LS(TAB)       &kp UP         &kp TAB       &kp PAGE_DOWN
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &sk LCTRL       &sk LSHFT       &sk LALT        &sk LGUI        &kp LG(SPACE)                                                                              &kp HOME        &kp LEFT        &kp DOWN       &kp RIGHT       &kp END
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &kp LC(W)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &kp LC(LS(W))   &trans          &trans                     &trans          &trans          &trans          &kp LS(TAB)      &kp ESC         &kp TAB         &trans
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                      &trans          &trans          &trans                     &kp BSPC        &kp DEL         &trans
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LA(LEFT) LA(RIGHT) &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        symbols_layer {
            display-name = "symbols";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
      &trans          &trans          &trans          &trans          &trans                                                                                      &kp FR_TILDE    &kp FR_AT      &caret_trema   &dollar_pound    &kp FR_GRAVE
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &sk LCTRL       &sk LSHFT       &sk LALT        &sk LGUI        &trans                                                                                     &hash_micro     &kp FR_MINUS    &amps_euro      &kp FR_QMARK    &kp FR_EXCL
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &trans          &trans          &trans          &trans          &trans          &trans           &trans                     &trans          &trans        &kp FR_PRCNT     &kp FR_UNDER    &kp FR_LT       &kp FR_PIPE     &kp FR_GT
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                      &trans          &trans           &trans                     &kp BSPC        &kp DEL         &trans
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LA(LEFT) LA(RIGHT) &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        numbers_layer {
            display-name = "numbers";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
    &kp KP_MULTIPLY    &kp KP_N7      &kp KP_N8        &kp KP_N9      &kp KP_MINUS                                                                                &kp FR_J        &kp FR_L        &kp FR_U        &kp FR_Y        &as_quotes   
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &kp KP_SLASH     &kp KP_N4      &kp KP_N5        &kp KP_N6      &kp KP_PLUS                                                                                 &kp FR_M        &sk LGUI        &sk LALT        &sk LSHFT       &sk LCTRL
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
         &zeros        &kp KP_N1        &twos          &kp KP_N3      &kp FR_EQUAL    &trans           &trans                    &trans           &trans         &kp FR_PRCNT     &kp FR_UNDER    &kp FR_LT       &kp FR_EQUAL    &kp FR_GT
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                      &trans          &kp KP_DOT       &kp BSPC                  &kp BSPC         &kp DEL         &trans
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LA(LEFT) LA(RIGHT) &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        functions_layer {
            display-name = "functions";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
      &trans           &kp F7         &kp F8           &kp F9         &kp F10                                                                                     &trans          &trans          &trans          &trans          &trans
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &trans           &kp F4         &kp F5           &kp F6         &kp F11                                                                                     &trans          &sk LGUI        &sk LALT        &sk LSHFT       &sk LCTRL
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &trans           &kp F1         &kp F2           &kp F3         &kp F12         &trans           &trans                    &trans           &trans          &trans          &trans          &trans          &trans          &trans
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                      &trans          &trans           &trans                    &kp BSPC         &kp DEL         &trans
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LA(LEFT) LA(RIGHT) &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


        management_layer {
            display-name = "management";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
        &trans          &trans          &trans          &trans          &trans                                                                                      &trans          &trans          &trans          &trans          &trans
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                                                                  &trans          &sk LGUI        &sk LALT        &sk LSHFT       &sk LCTRL
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
        &trans          &trans          &trans        &bt BT_CLR        &trans          &trans           &trans                     &trans          &trans          &trans          &trans          &trans          &trans          &trans
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                        &trans          &trans           &trans                     &trans       &tog L_GAM         &trans
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp LA(LEFT) LA(RIGHT) &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        gaming_layer {
            display-name = "gaming";
            bindings = <
// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
       &kp CAPS         &kp FR_A        &kp FR_Z        &kp FR_E        &kp FR_R                                                                                     &none           &none           &none           &none           &none
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
       &kp LSHIFT       &kp FR_Q        &kp FR_S        &kp FR_D        &kp FR_G                                                                                     &none           &none           &none           &none           &none
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
       &kp LCTRL        &kp FR_W        &kp FR_X        &kp FR_C        &kp FR_F       &kp SPACE        &kp ESC                      &none           &none           &none           &none           &none           &none           &none
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
                                                                         &none         &kp SPACE       &kp FR_H                      &none       &tog L_GAM          &none
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯
            >;
            sensor-bindings = <&inc_dec_kp TAB FR_M &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };
    };
};







// ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮                                                                          ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
//      &trans          &trans          &trans          &trans          &trans                                                                                      &trans          &trans          &trans          &trans          &trans
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤                                                                          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
//      &sk LCTRL       &sk LSHFT       &sk LALT        &sk LGUI        &trans                                                                                      &trans          &sk LGUI        &sk LALT        &sk LSHFT       &sk LCTRL
// ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┬───────────────╮          ╭───────────────┬───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤
//      &trans          &trans          &trans          &trans          &trans          &trans           &trans                     &trans          &trans          &trans          &trans          &trans          &trans          &trans
// ╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤          ├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┼───────────────┴───────────────╯
//                                                                      &trans          &trans           &trans                     &trans          &trans          &trans
//                                                                 ╰───────────────┴───────────────┴───────────────╯          ╰───────────────┴───────────────┴───────────────╯